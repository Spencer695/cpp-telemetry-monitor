<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Codex" version="29.0.0"><diagram id="telemetry-flow" name="Data flow"><mxGraphModel dx="1580" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="1120" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;C++ Telemetry Monitor&lt;/b&gt;  /  Data flow" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=32;fontColor=#142b49;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1480" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="From simulated sensor readings to CSV capture and the optional Qt dashboard" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#52647c;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1450" height="35" as="geometry"/></mxCell>
<mxCell id="inputs" value="INPUT SOURCES" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;swimlane;startSize=44;horizontal=1;rounded=1;arcSize=8;collapsible=0;container=1;recursiveResize=0;fillColor=#e2e8f0;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="190" height="670" as="geometry"/></mxCell>
<mxCell id="receiver" value="RECEIVER THREAD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;swimlane;startSize=44;horizontal=1;rounded=1;arcSize=8;collapsible=0;container=1;recursiveResize=0;fillColor=#dbeafe;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="260" y="150" width="240" height="670" as="geometry"/></mxCell>
<mxCell id="fifo" value="SHARED QUEUE" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;swimlane;startSize=44;horizontal=1;rounded=1;arcSize=8;collapsible=0;container=1;recursiveResize=0;fillColor=#fef3c7;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="530" y="150" width="195" height="670" as="geometry"/></mxCell>
<mxCell id="processor" value="PROCESSING THREAD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;swimlane;startSize=44;horizontal=1;rounded=1;arcSize=8;collapsible=0;container=1;recursiveResize=0;fillColor=#dcfce7;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="755" y="150" width="240" height="670" as="geometry"/></mxCell>
<mxCell id="shared" value="SHARED GUI STATE" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;swimlane;startSize=44;horizontal=1;rounded=1;arcSize=8;collapsible=0;container=1;recursiveResize=0;fillColor=#fef3c7;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1025" y="150" width="210" height="670" as="geometry"/></mxCell>
<mxCell id="gui" value="QT GUI THREAD" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;swimlane;startSize=44;horizontal=1;rounded=1;arcSize=8;collapsible=0;container=1;recursiveResize=0;fillColor=#ede9fe;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1265" y="150" width="275" height="670" as="geometry"/></mxCell>
<mxCell id="sensor" value="&lt;b&gt;Simulated sensors&lt;/b&gt;&lt;br&gt;&lt;br&gt;Python simulator&lt;br&gt;or Qt demo sender" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="inputs"><mxGeometry x="15" y="85" width="160" height="125" as="geometry"/></mxCell>
<mxCell id="wire" value="&lt;b&gt;Wire format&lt;/b&gt;&lt;br&gt;&lt;br&gt;device,sequence,value\n&lt;br&gt;&lt;br&gt;TCP is a byte stream;&lt;br&gt;reads may split or&lt;br&gt;combine messages." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="inputs"><mxGeometry x="10" y="285" width="170" height="180" as="geometry"/></mxCell>
<mxCell id="sourceNote" value="Current demo uses loopback TCP, not physical sensors." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#52647c;" vertex="1" parent="1"><mxGeometry x="55" y="710" width="160" height="85" as="geometry"/></mxCell>
<mxCell id="socket" value="&lt;b&gt;TCP receiver&lt;/b&gt;&lt;br&gt;&lt;br&gt;127.0.0.1 : port&lt;br&gt;select() + recv()&lt;br&gt;Up to 32 clients" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#eff6ff;strokeColor=#60a5fa;" vertex="1" parent="receiver"><mxGeometry x="20" y="85" width="200" height="125" as="geometry"/></mxCell>
<mxCell id="framer" value="&lt;b&gt;Per-client framing&lt;/b&gt;&lt;br&gt;&lt;br&gt;LineFramer.feed()&lt;br&gt;Newline-delimited frames&lt;br&gt;256-byte frame limit" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="receiver"><mxGeometry x="20" y="255" width="200" height="115" as="geometry"/></mxCell>
<mxCell id="parse" value="&lt;b&gt;Validate + timestamp&lt;/b&gt;&lt;br&gt;&lt;br&gt;parse_reading(line)&lt;br&gt;Set received_ms&lt;br&gt;try_push(reading)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#eff6ff;strokeColor=#60a5fa;" vertex="1" parent="receiver"><mxGeometry x="20" y="435" width="200" height="115" as="geometry"/></mxCell>
<mxCell id="invalid" value="&lt;b&gt;Invalid / oversized&lt;/b&gt;&lt;br&gt;Count malformed frames;&lt;br&gt;close oversized client." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#fff1f2;strokeColor=#fda4af;" vertex="1" parent="receiver"><mxGeometry x="20" y="585" width="200" height="65" as="geometry"/></mxCell>
<mxCell id="queueNote" value="&lt;b&gt;Bounded FIFO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Default capacity: 256&lt;br&gt;&lt;br&gt;Mutex guards deque.&lt;br&gt;Insertion takes the lock,&lt;br&gt;but never waits for&lt;br&gt;free queue capacity.&lt;br&gt;&lt;br&gt;Full: drop newest;&lt;br&gt;increment dropped." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#fffbeb;strokeColor=#fbbf24;" vertex="1" parent="fifo"><mxGeometry x="15" y="85" width="165" height="235" as="geometry"/></mxCell>
<mxCell id="queue" value="&lt;b&gt;Reading queue&lt;/b&gt;&lt;br&gt;&lt;br&gt;Successful push:&lt;br&gt;notify_one()" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#fffbeb;strokeColor=#fbbf24;" vertex="1" parent="fifo"><mxGeometry x="15" y="435" width="165" height="115" as="geometry"/></mxCell>
<mxCell id="processorNote" value="&lt;b&gt;Consumer waits&lt;/b&gt;&lt;br&gt;&lt;br&gt;pop() waits on a&lt;br&gt;condition variable.&lt;br&gt;&lt;br&gt;Wakes when data arrives&lt;br&gt;or the queue closes.&lt;br&gt;&lt;br&gt;FIFO processing;&lt;br&gt;one record at a time." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="processor"><mxGeometry x="20" y="85" width="200" height="235" as="geometry"/></mxCell>
<mxCell id="process" value="&lt;b&gt;Process reading&lt;/b&gt;&lt;br&gt;&lt;br&gt;Write + flush CSV&lt;br&gt;Increment processed&lt;br&gt;Call observer.reading()" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#f0fdf4;strokeColor=#4ade80;" vertex="1" parent="processor"><mxGeometry x="20" y="435" width="200" height="115" as="geometry"/></mxCell>
<mxCell id="csv" value="&lt;b&gt;CSV capture&lt;/b&gt;&lt;br&gt;received_ms, device,&lt;br&gt;sequence, value" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#f0fdf4;strokeColor=#4ade80;" vertex="1" parent="processor"><mxGeometry x="20" y="585" width="200" height="65" as="geometry"/></mxCell>
<mxCell id="stateNote" value="&lt;b&gt;DashboardState&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mutex protects latest&lt;br&gt;reading per device,&lt;br&gt;status and listening port.&lt;br&gt;&lt;br&gt;At most 128 devices&lt;br&gt;shown in dashboard.&lt;br&gt;CSV is unaffected." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#fffbeb;strokeColor=#fbbf24;" vertex="1" parent="shared"><mxGeometry x="15" y="85" width="180" height="235" as="geometry"/></mxCell>
<mxCell id="state" value="&lt;b&gt;Latest readings&lt;/b&gt;&lt;br&gt;&lt;br&gt;observer.reading()&lt;br&gt;updates latest[device]&lt;br&gt;under the state mutex" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#fffbeb;strokeColor=#fbbf24;" vertex="1" parent="shared"><mxGeometry x="15" y="435" width="180" height="115" as="geometry"/></mxCell>
<mxCell id="guiNote" value="&lt;b&gt;Thread ownership&lt;/b&gt;&lt;br&gt;&lt;br&gt;Worker callbacks update&lt;br&gt;shared state only.&lt;br&gt;&lt;br&gt;Widgets are accessed&lt;br&gt;only on the GUI thread.&lt;br&gt;&lt;br&gt;Qt demo also sends&lt;br&gt;over real TCP." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="gui"><mxGeometry x="20" y="85" width="235" height="235" as="geometry"/></mxCell>
<mxCell id="timer" value="&lt;b&gt;QTimer: every 100 ms&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dashboard::refresh()&lt;br&gt;Lock, copy snapshot,&lt;br&gt;unlock; then update UI" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#f5f3ff;strokeColor=#a78bfa;" vertex="1" parent="gui"><mxGeometry x="20" y="435" width="235" height="115" as="geometry"/></mxCell>
<mxCell id="widgets" value="&lt;b&gt;Qt dashboard&lt;/b&gt;&lt;br&gt;Device table + counters&lt;br&gt;Start / Stop and drain" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#f5f3ff;strokeColor=#a78bfa;" vertex="1" parent="gui"><mxGeometry x="20" y="585" width="235" height="65" as="geometry"/></mxCell>
<mxCell id="e1" value="TCP bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sensor" target="socket"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e2" value="bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="socket" target="framer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3" value="complete lines" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="framer" target="parse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="parse" target="queue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5" value="pop()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="queue" target="process"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e6" value="callback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="process" target="state"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e7" value="copy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="state" target="timer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="timer" target="widgets"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="process" target="csv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;strokeColor=#e11d48;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="parse" target="invalid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="lifecycle" value="SERVER LIFECYCLE  /  QThread in the GUI build; main thread in the CLI" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;swimlane;horizontal=1;startSize=38;rounded=1;collapsible=0;container=1;fillColor=#e2e8f0;swimlaneFillColor=#f8fafc;strokeColor=#cbd5e1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="865" width="1500" height="170" as="geometry"/></mxCell>
<mxCell id="status" value="&lt;b&gt;Status snapshots&lt;/b&gt;&lt;br&gt;Receiver / processor update atomic counters.&lt;br&gt;Lifecycle sends observer.status() about every 200 ms&lt;br&gt;and observer.listening() when ready; both lock DashboardState." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="lifecycle"><mxGeometry x="20" y="55" width="650" height="95" as="geometry"/></mxCell>
<mxCell id="stop" value="&lt;b&gt;Normal stop and drain&lt;/b&gt;&lt;br&gt;GUI sets atomic stop_requested (or CLI gets signal / timeout).&lt;br&gt;Lifecycle sets stop, joins receiver (clients close), closes queue,&lt;br&gt;joins processor after FIFO drains, then reports completion." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;rounded=1;arcSize=8;spacing=6;fontSize=14;fillColor=#ffffff;strokeColor=#94a3b8;" vertex="1" parent="lifecycle"><mxGeometry x="715" y="55" width="765" height="95" as="geometry"/></mxCell>
<mxCell id="e11" value="status + port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;dashed=1;strokeColor=#64748b;exitX=0.9;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="status" target="state"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="645" y="840"/><mxPoint x="1130" y="840"/></Array></mxGeometry></mxCell>
<mxCell id="e12" value="stop_requested" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#334155;labelBackgroundColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;dashed=1;strokeColor=#64748b;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="widgets" target="stop"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="767"/><mxPoint x="1560" y="967"/></Array></mxGeometry></mxCell>
<mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;   Blue: reading data     Red: rejected input     Gray dashed: status / control     Yellow: shared synchronized storage" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#172b4d;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#52647c;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1490" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
